{
  "rules": {
    /* usersPublic/<uid>/gamesWonProofs/<quest>/<seed> is the only place
       where win proofs are stored and synced between devices. A proof is
       the full playthrough log (aleaSeed + every jump) plus the server
       "created" timestamp; it is written once and never overwritten.
       The whole usersPublic/<uid> node is readable only by its owner and
       nobody can list usersPublic. One proof is public by its exact path:
       the champions row gives the uid, the quest and the seed, and Verify
       downloads only that proof.
       info/name and gamesWonCount are written only by the old client; the
       current client keeps the name and the count in champions/<uid>. */
    "usersPublic": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "info": {
          ".write": "$uid === auth.uid"
        },
        "gamesWonCount": {
          ".write": "$uid === auth.uid"
        },
        "gamesWonProofs": {
          "$gameName": {
            "$aleaSeed": {
              ".read": true,
              ".write": "$uid === auth.uid",
              ".validate": "newData.hasChild('created') && newData.child('created').val() === now && data.val() === null"
            }
          }
        }
      }
    },

    /* usersPrivate/<uid> is the player's settings synced between devices
       (config: ranger name, music, last played quest). Owner-only.
       usersPrivate/<uid>/wongames is old data: earlier clients kept one
       more copy of every win proof there. The current client does not use
       it; the data is left in the database just in case. It has no rules,
       so it is closed for reading and writing ($other does not match it). */
    "usersPrivate": {
      "$uid": {
        "wongames": {},
        "$other": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        }
      }
    },

    /* customQuests is unchanged. A user can read and write their own
       custom quests; anyone can read a quest marked isPublic. */
    "customQuests": {
      "$user_id": {
        ".read": "$user_id === auth.uid",
        "$quest_name": {
          ".write": "$user_id === auth.uid",
          ".read": "$user_id === auth.uid || data.child('isPublic').val() == true"
        }
      }
    },

    /* wonProofs (a flat table of win proofs from an unfinished 2019
       redesign) is old data too: not used by the current client, left in
       the database just in case. No rules here, so it is closed for
       reading and writing. */

    /* champions/<uid> is the public leaderboard row (no proofs):
         name          — ranger name
         gamesWonCount — number of quests in "games"
         games/<quest> — array of seeds of won games (oldest first); Verify
                         takes them from the end and reads
                         usersPublic/<uid>/gamesWonProofs/<quest>/<seed>
         updatedAt     — must be the server timestamp
       Public read, owner write. Extra fields are rejected. */
    "champions": {
      ".read": true,
      ".indexOn": ["gamesWonCount"],
      "$uid": {
        ".write": "$uid === auth.uid",
        ".validate": "newData.hasChildren(['name', 'gamesWonCount', 'games', 'updatedAt'])",
        "name": {
          ".validate": "newData.isString()"
        },
        "gamesWonCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "games": {
          "$gameName": {
            ".validate": "newData.hasChildren()",
            "$index": {
              ".validate": "newData.isString()"
            }
          }
        },
        "updatedAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
